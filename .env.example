# Deployment mode: admin | storefront | all.
# Unset: local development serves all; production serves admin + APIs only.
# Render now: admin. Future public website: storefront.
APP_MODE=

# Comma-separated Indian mobile numbers allowed to use /admin/login.
# Example: ADMIN_PHONE_NUMBERS=9876543210,+919876543211
ADMIN_PHONE_NUMBERS=

# Required dedicated secret (at least 32 characters) for signed name/mobile sessions.
# Generate a random value; there is no database-credential fallback.
MEMBER_SESSION_SECRET=

# Supabase project URL and publishable/anon key. These two values are designed
# for browser use; database access is protected by Row Level Security.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase PostgreSQL pooler URL used only by the Next.js server. In Supabase,
# open Connect > Transaction pooler and use the URI shown there.
DATABASE_URL=

# Razorpay (optional; COD remains available without these). Configure the
# webhook at /api/payments/webhook and set the corresponding signing secret.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Never expose a Supabase secret/service-role key as NEXT_PUBLIC_*.
